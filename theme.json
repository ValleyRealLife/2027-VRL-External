{
  "$schema": "https://community.rockrms.com/schema/2024-10-01/theme.schema.json",
  "name": "Valley Real Life 2027",
  "description": "The 2027 public website theme for Valley Real Life: light-first, VRL green on warm neutrals, Montserrat type, with dark contrast bands. Built on Rock v18's NextGen theme system.",
  "purpose": "web",
  "availableIconSets": ["tabler", "fontawesome"],
  "fields": [
    {
      "type": "panel",
      "title": "Brand",
      "expanded": true,
      "fields": [
        { "type": "color", "name": "Primary Color",   "variable": "base-primary",   "default": "#9bc93c",
          "description": "VRL green (v-green-500)." },
        { "type": "color", "name": "Secondary Color", "variable": "base-secondary", "default": "#0b0e0a",
          "description": "Ink, used for the dark bands (v-neutral-900)." },
        { "type": "color", "name": "Link Color",      "variable": "base-link",      "default": "#617e00",
          "description": "Darker green that passes AA contrast on light surfaces (v-green-700)." },
        { "type": "image", "name": "Site Logo",       "variable": "logo-image",
          "description": "Reserved. The header and footer currently render Assets/Images/vrl_logo.png directly (see Assets/Lava/PageNav.lava) so the ink filter can be applied; this field is not consumed yet. If you rename the theme folder, update this default path too.",
          "default": "~/Themes/2027 VRL External/Assets/Images/vrl_logo.png" },
        { "type": "literal", "name": "Site Logo Height",       "variable": "logo-height", "default": "clamp(28px, 1.2vw + 22px, 34px)",
          "description": "Target logo height. The logo is sized by the width this works out to, so it keeps its proportions and never stretches. Any CSS length works; the default is fluid, 28px on phones up to 34px from 1000px wide." },
        { "type": "literal", "name": "Site Logo Aspect Ratio", "variable": "logo-aspect", "default": "694 / 168",
          "description": "Width / height of the logo file (vrl_logo.png is 694 × 168). Change only if the logo file changes." }
      ]
    },
    {
      "type": "panel",
      "title": "Header & Footer",
      "fields": [
        { "type": "color", "name": "Header Background",     "variable": "site-header-background",  "default": "#ffffff" },
        { "type": "color", "name": "Page Title Background", "variable": "page-title-background",   "default": "#f0f2ef" },
        { "type": "color", "name": "Page Title Text",       "variable": "page-title-foreground",   "default": "#0b0e0a" },
        { "type": "color", "name": "Footer Background",     "variable": "site-footer-background",  "default": "#030402" }
      ]
    },
    {
      "type": "panel",
      "title": "Interface Colors",
      "fields": [
        { "type": "color", "name": "Interface Color Strongest", "variable": "base-interface-strongest", "default": "#030402" },
        { "type": "color", "name": "Interface Color Stronger",  "variable": "base-interface-stronger",  "default": "#0b0e0a" },
        { "type": "color", "name": "Interface Color Strong",    "variable": "base-interface-strong",    "default": "#3f443c" },
        { "type": "color", "name": "Interface Color Medium",    "variable": "base-interface-medium",    "default": "#8d918b" },
        { "type": "color", "name": "Interface Color Soft",      "variable": "base-interface-soft",      "default": "#dfe2de" },
        { "type": "color", "name": "Interface Color Softer",    "variable": "base-interface-softer",    "default": "#f0f2ef" },
        { "type": "color", "name": "Interface Color Softest",   "variable": "base-interface-softest",   "default": "#f7f9f6" }
      ]
    },
    {
      "type": "panel",
      "title": "Status Colors",
      "fields": [
        { "type": "color", "name": "Danger Color",   "variable": "base-danger",   "default": "#d70015" },
        { "type": "color", "name": "Success Color",  "variable": "base-success",  "default": "#01a11e" },
        { "type": "color", "name": "Warning Color",  "variable": "base-warning",  "default": "#e58600" },
        { "type": "color", "name": "Info Color",     "variable": "base-info",     "default": "#005dd7" },
        { "type": "color", "name": "Critical Color", "variable": "base-critical", "default": "#ee7725" }
      ]
    },
    {
      "type": "panel",
      "title": "Typography",
      "fields": [
        { "type": "literal", "name": "Title Font Family", "variable": "font-family-title",
          "default": "'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif" },
        { "type": "literal", "name": "Body Font Family", "variable": "font-family-body",
          "default": "'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif" },
        { "type": "literal", "name": "Regular Font Size", "variable": "font-size-regular", "default": "16px" },
        { "type": "literal", "name": "H1 Font Size", "variable": "font-size-h1", "default": "48px" },
        { "type": "literal", "name": "H2 Font Size", "variable": "font-size-h2", "default": "40px" },
        { "type": "literal", "name": "H3 Font Size", "variable": "font-size-h3", "default": "28px" },
        { "type": "literal", "name": "H4 Font Size", "variable": "font-size-h4", "default": "22px" },
        { "type": "literal", "name": "H5 Font Size", "variable": "font-size-h5", "default": "18px" },
        { "type": "literal", "name": "H6 Font Size", "variable": "font-size-h6", "default": "16px" }
      ]
    }
  ]
}
