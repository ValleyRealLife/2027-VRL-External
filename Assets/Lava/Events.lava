{% comment %}
    EVENTS PAGE — for an HTML block in the events page's Main zone
    (InnerDefault).

    Block content:            {% include '~~/Assets/Lava/Events.lava' %}
    Enabled Lava Commands:    Sql
    Cache Duration:           0 while iterating (later: short, events change)

    Three sections:
      Featured     events with audience `featuredAudienceId` (150) as photo
                   cards (event-card--feature: date top left, View details
                   bottom right) in a swipe rail (rail arrows: theme.js)
      Filter       one chip per audience (defined type 16, minus 150) that
                   an upcoming event has, plus All. Filters the list below in
                   the browser (theme.js "Events filter"); ?audience=<id> in
                   the address picks one on load, so a view can be shared.
                   Without JavaScript the chips stay hidden and every event
                   shows.
      All events   every upcoming event as a grid of the same cards (up to
                   three across), with a time row. Featured events are
                   included, so filtering still finds them.

    One card per event: its next occurrence on calendar `calendarId`.
    Promotion: an occurrence with a PromotionStart in the future is hidden
    until then; once it passes, the card gets a "New" sticker until the end
    of the next day. Empty PromotionStart = shown, no sticker.
    Tag: the event's FIRST audience other than 150 (by the defined values'
    order); one tag only. The filter uses all of an event's audiences.
    Card markup: Partials/EventCard.lava. Styled by Styles/_events.scss.

    DATA SOURCE: SQL, adapted from HomeEvents.lava. ROCK: this is the one
    place to change when the data model moves off the events calendar.
{% endcomment %}

{%- comment -%} ===== SETTINGS ===== {%- endcomment -%}
{%- assign calendarId = 1 -%}
{%- assign featuredAudienceId = 150 -%}
{%- assign audienceTypeId = 16 -%}
{%- assign maxFeatured = 12 -%}
{%- assign maxAll = 120 -%}
{%- assign fallbackImageGuid = 'ea573748-2354-4f4a-875d-b8d2dfa30e5d' -%}
{%- comment -%} The detail page (route events/{EventOccurrenceId}); an event's own Details URL wins {%- endcomment -%}
{%- assign detailsPageUrl = '/events' -%}

{%- comment -%} ===== VISIBLE OCCURRENCES: the shared CTEs (promotion gate, IsNew), as visibleOccSql ===== {%- endcomment -%}
{%- capture visibleOccSql %}{% include '~~/Assets/Lava/Partials/EventVisibleOccurrences.lava' %}{% endcapture -%}

{%- comment -%} ===== DATA SOURCE: every upcoming event, soonest first ===== {%- endcomment -%}
{% sql return:'events' securityenabled:'false' %}
    WITH {{ visibleOccSql }}
    SELECT TOP ({{ maxAll }})
        o.[Id] AS [OccurrenceId],
        ei.[Name] AS [EventName],
        o.[NextStartDateTime],
        o.[Location],
        o.[IsNew],
        ei.[DetailsUrl],
        ei.[Summary],
        ei.[Description],
        bf.[Guid] AS [PhotoGuid],
        CASE WHEN EXISTS (
            SELECT 1 FROM [EventItemAudience] f
            WHERE f.[EventItemId] = ei.[Id] AND f.[DefinedValueId] = {{ featuredAudienceId }}
        ) THEN 1 ELSE 0 END AS [IsFeatured],
        (
            SELECT TOP 1 dv.[Value]
            FROM [EventItemAudience] a
            INNER JOIN [DefinedValue] dv ON dv.[Id] = a.[DefinedValueId]
            WHERE a.[EventItemId] = ei.[Id] AND a.[DefinedValueId] <> {{ featuredAudienceId }}
            ORDER BY dv.[Order]
        ) AS [Tag],
        STUFF((
            SELECT ' ' + CAST(a.[DefinedValueId] AS varchar(10))
            FROM [EventItemAudience] a
            WHERE a.[EventItemId] = ei.[Id] AND a.[DefinedValueId] <> {{ featuredAudienceId }}
            FOR XML PATH('')
        ), 1, 1, '') AS [AudienceIds]
    FROM [nextOcc] o
    INNER JOIN [EventItem] ei ON ei.[Id] = o.[EventItemId]
    LEFT JOIN [BinaryFile] bf ON bf.[Id] = ei.[PhotoId]
    WHERE o.[rn] = 1
      AND ei.[IsActive] = 1
      AND ei.[IsApproved] = 1
      AND EXISTS (
          SELECT 1 FROM [EventCalendarItem] eci
          WHERE eci.[EventItemId] = ei.[Id] AND eci.[EventCalendarId] = {{ calendarId }}
      )
    ORDER BY o.[NextStartDateTime] ASC
{% endsql %}

{%- comment -%} ===== The filter's audiences: those an upcoming event has ===== {%- endcomment -%}
{% sql return:'audiences' securityenabled:'false' %}
    WITH {{ visibleOccSql }}
    SELECT dv.[Id], dv.[Value]
    FROM [DefinedValue] dv
    WHERE dv.[DefinedTypeId] = {{ audienceTypeId }}
      AND dv.[Id] <> {{ featuredAudienceId }}
      AND dv.[IsActive] = 1
      AND EXISTS (
          SELECT 1
          FROM [EventItemAudience] a
          INNER JOIN [EventItem] ei ON ei.[Id] = a.[EventItemId]
          WHERE a.[DefinedValueId] = dv.[Id]
            AND ei.[IsActive] = 1 AND ei.[IsApproved] = 1
            AND EXISTS (SELECT 1 FROM [nextOcc] o WHERE o.[EventItemId] = ei.[Id])
            AND EXISTS (SELECT 1 FROM [EventCalendarItem] eci WHERE eci.[EventItemId] = ei.[Id] AND eci.[EventCalendarId] = {{ calendarId }})
      )
    ORDER BY dv.[Order], dv.[Value]
{% endsql %}

{%- assign eventCount = events | Size -%}
{%- assign featuredCount = 0 -%}

{%- assign featuredHtml = '' -%}
{%- assign allHtml = '' -%}
{%- for event in events -%}
    {%- comment -%} Values the card reads (Partials/EventCard.lava) {%- endcomment -%}
    {%- assign cardItemName = event.EventName -%}
    {%- assign cardItemStart = event.NextStartDateTime -%}
    {%- assign cardItemTag = event.Tag | Default:'' -%}
    {%- assign cardItemLocation = event.Location | Default:'' | Trim -%}
    {%- assign cardItemIsNew = false -%}
    {%- if event.IsNew == 1 %}{% assign cardItemIsNew = true %}{% endif -%}

    {%- if event.DetailsUrl and event.DetailsUrl != '' -%}
        {%- assign cardItemUrl = event.DetailsUrl -%}
    {%- else -%}
        {%- capture cardItemUrl %}{{ detailsPageUrl }}/{{ event.OccurrenceId }}{% endcapture -%}
    {%- endif -%}

    {%- if event.PhotoGuid != null -%}
        {%- capture cardItemImage %}/GetImage.ashx?guid={{ event.PhotoGuid }}&w=840&h=360&mode=crop{% endcapture -%}
    {%- else -%}
        {%- capture cardItemImage %}/GetImage.ashx?guid={{ fallbackImageGuid }}&w=840&h=360&mode=crop{% endcapture -%}
    {%- endif -%}

    {%- assign cardItemTeaser = event.Summary | StripHtml | Trim -%}
    {%- if cardItemTeaser == '' %}{% assign cardItemTeaser = event.Description | StripHtml | Trim %}{% endif %}

    {%- assign gridImage = cardItemImage -%}

    {%- comment -%} Featured rail: the wide card, full-size photo, no audience tag {%- endcomment -%}
    {%- if event.IsFeatured == 1 and featuredCount < maxFeatured -%}
        {%- assign featuredCount = featuredCount | Plus:1 -%}
        {%- assign cardItemMeta = false -%}
        {%- assign cardItemFeature = true -%}
        {%- assign cardItemTag = '' -%}
        {%- assign cardItemImage = gridImage | Replace:'&w=840&h=360','&w=1260&h=540' -%}
        {%- assign cardItemAudiences = '' -%}
        {%- assign cardItemShareId = '' -%}
        {%- capture featuredCard %}{% include '~~/Assets/Lava/Partials/EventCard.lava' %}{% endcapture -%}
        {%- assign featuredHtml = featuredHtml | Append:featuredCard -%}
    {%- endif -%}

    {%- comment -%} All events: with the time row, the tag and the filter's audience ids {%- endcomment -%}
    {%- assign cardItemImage = gridImage -%}
    {%- assign cardItemTag = event.Tag | Default:'' -%}
    {%- assign cardItemMeta = true -%}
    {%- assign cardItemFeature = false -%}
    {%- assign cardItemAudiences = event.AudienceIds | Default:'' -%}
    {%- assign cardItemShareId = 'event-share-' | Append:event.OccurrenceId -%}
    {%- capture allCard %}{% include '~~/Assets/Lava/Partials/EventCard.lava' %}{% endcapture -%}
    {%- assign allHtml = allHtml | Append:allCard -%}
{%- endfor -%}

<div class="events-page">

  {%- if featuredCount > 0 %}
  <section class="events-page__section" aria-labelledby="events-featured-title">
    <div class="sermons-divider">
      <h2 id="events-featured-title">Featured</h2>
    </div>
    <div class="events__rail-wrap">
      <button class="events__nav events__nav--prev" type="button" data-rail-prev>
        <span class="u-visually-hidden">Scroll featured events left</span>
        <svg width="22" height="22" aria-hidden="true"><use href="#i-chevron-left"/></svg>
      </button>
      <ul class="events__rail" tabindex="0" aria-label="Featured events, scrollable">
        {{ featuredHtml }}
      </ul>
      <button class="events__nav events__nav--next" type="button" data-rail-next>
        <span class="u-visually-hidden">Scroll featured events right</span>
        <svg width="22" height="22" aria-hidden="true"><use href="#i-chevron-right"/></svg>
      </button>
    </div>
  </section>
  {%- endif %}

  <section class="events-page__section" aria-labelledby="events-all-title" data-event-filter>
    <div class="events-page__head">
    <div class="sermons-divider">
      <h2 id="events-all-title">All events</h2>
    </div>

    {%- if eventCount == 0 %}
    <p class="events__empty">There are no upcoming events right now. Check back soon.</p>
    {%- else %}
    <div class="events-page__bar">
      {%- assign audienceCount = audiences | Size -%}
      {%- if audienceCount > 1 %}
      <div class="events-filter" role="group" aria-label="Filter by audience" data-event-filter-chips hidden>
        <button type="button" class="pill-btn" data-audience="" aria-pressed="true">All</button>
        {%- for audience in audiences %}
        <button type="button" class="pill-btn" data-audience="{{ audience.Id }}" aria-pressed="false">{{ audience.Value }}</button>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    {%- endif %}
    </div>
    {%- if eventCount > 0 %}

    <ul class="events-grid" role="list" data-event-list>
      {{ allHtml }}
    </ul>
    <p class="events__empty" data-event-empty hidden>No upcoming events for this audience yet.</p>
    {%- endif %}
  </section>

</div>
