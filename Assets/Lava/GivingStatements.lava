{% comment %}
    GIVING STATEMENTS — the Lava Template of the Contribution Statement List
    Lava block in the History panel of the manage-giving page.

    Lava Template setting:    {% include '~~/Assets/Lava/GivingStatements.lava' %}
    CSS Class:                giving-panel giving-history

    Rock provides StatementYears (each with .Year) and DetailPage (the
    statement page; it takes ?StatementYear=). A sidebar list of year links,
    newest first; the current year is marked "Year to date". On desktop it
    sits left of the Transaction Report block (CSS Class giving-panel
    giving-history giving-report). The report is a Rock table, so phones
    don't get it; the note at the bottom says where to find it instead.
{% endcomment %}
{%- assign currentYear = 'Now' | Date:'yyyy' -%}
<nav class="account-tile giving-statements" aria-label="Giving statements">
  <h2 class="account-tile__title"><svg width="18" height="18" aria-hidden="true"><use href="#i-notebook"/></svg> Statements</h2>
  {%- if StatementYears != empty %}
  <ul class="giving-statements__list" role="list">
    {%- for statementYear in StatementYears %}
    <li><a class="giving-statements__year" href="{{ DetailPage }}?StatementYear={{ statementYear.Year }}">
      <span class="giving-statements__label">{{ statementYear.Year }}</span>
      {%- if statementYear.Year == currentYear %}<span class="giving-statements__note">Year to date</span>{% endif %}
      <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow-right"/></svg>
    </a></li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="account-tile__sub">No statements yet. They appear here after your first gift.</p>
  {%- endif %}
  <p class="giving-statements__device">To look up individual gifts by date, open this page on a computer or tablet.</p>
</nav>
