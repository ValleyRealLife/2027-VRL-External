{% comment %}
    VOLUNTEER LISTING — the volunteer page: the active opportunities in one
    connection type, in sections by team (Styles/_volunteer.scss; the jump
    list and dividers are Styles/_content.scss's).

    Block:                    an HTML block in the page's Main zone
    Block content:            {% include '~~/Assets/Lava/VolunteerListing.lava' %}
    Enabled Lava Commands:    RockEntity

    THE OPPORTUNITIES: active ones in connection type connectionTypeId, in the
    opportunities' order (drag to reorder in Rock), then by name. Each has a
    ConnectedTeam (single select of the Staff Teams defined type, teamTypeId;
    stores the value's Guid).

    SECTIONS: one per team, in the defined values' order; a team with no
    opportunities is left out. Opportunities without a team go in a last
    "More ways to serve" section. Each section: the team's divider, then a
    photo beside the list of its opportunities (sides alternate; phones:
    photo on top). Photos: PLACEHOLDER (the green gradient) until the team
    photos are chosen. The "On this page" jump list names the sections
    (theme.js highlights the one being read); left out when there's only one.

    THE LIST: each opportunity's name is a row link to its page
    (VolunteerOpportunityDetail.lava, detailUrl?OpportunityId=<id>, Blank
    layout), opened in the pop-up (theme.js "Frame pop-up",
    data-volunteer-modal; the address carries ?opportunity=<id> while open).

    CLOSING: who to ask when nothing fits (contactEmail). Until it's set, a
    placeholder marks the spot.
{% endcomment %}

{%- comment -%} ===== SETTINGS ===== {%- endcomment -%}
{%- assign connectionTypeId = 10 -%}
{%- assign teamTypeId = 131 -%}
{%- assign detailUrl = '/next-steps/volunteer/detail' -%}
{%- assign otherHeading = 'More ways to serve' -%}
{%- assign contactEmail = '' -%}{%- comment -%} e.g. volunteer@vrl.church: the closing's button {%- endcomment -%}
{%- assign chevron = '<svg width="18" height="18" aria-hidden="true"><use href="#i-chevron-right"/></svg>' -%}

{%- connectionopportunity where:'ConnectionTypeId == {{ connectionTypeId }} && IsActive == true' sort:'Order, PublicName' securityenabled:'false' -%}
{%- assign opportunities = connectionopportunityItems -%}
{%- endconnectionopportunity -%}

{%- comment -%} Build the sections first, so the jump list only names the ones that have something {%- endcomment -%}
{%- assign tocLinks = '' -%}
{%- assign sectionCount = 0 -%}
{%- assign teamGuids = '|' -%}
{%- capture sectionsHtml -%}
  {%- definedvalue where:'DefinedTypeId == {{ teamTypeId }}' sort:'Order' securityenabled:'false' -%}
  {%- for team in definedvalueItems -%}
    {%- assign teamGuid = team.Guid | Append:'' | Downcase -%}
    {%- assign teamGuids = teamGuids | Append:teamGuid | Append:'|' -%}
    {%- capture rows -%}
      {%- for opp in opportunities -%}
        {%- assign oppTeam = opp | Attribute:'ConnectedTeam','RawValue' | Downcase -%}
        {%- if oppTeam == teamGuid %}
        <li><a class="row-link" href="{{ detailUrl }}?OpportunityId={{ opp.Id }}" data-volunteer-modal="{{ opp.Id }}"><span class="row-link__label">{{ opp.PublicName | Default:opp.Name }}</span><span class="row-link__chev">{{ chevron }}</span></a></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign rows = rows | Trim -%}
    {%- if rows != '' -%}
      {%- assign sectionId = 'serve-' | Append:team.Value | ToCssClass -%}
      {%- assign flip = sectionCount | Modulo:2 -%}
      {%- assign sectionCount = sectionCount | Plus:1 -%}
      {%- capture tocLink %}<li><a class="content-toc__link" href="#{{ sectionId }}">{{ team.Value }}</a></li>{% endcapture -%}
      {%- assign tocLinks = tocLinks | Append:tocLink %}
  <div class="sermons-divider" id="{{ sectionId }}"><h2>{{ team.Value }}</h2></div>
  <div class="volunteer-team{% if flip == 1 %} volunteer-team--flip{% endif %}">
    <figure class="volunteer-team__photo content-photo content-photo--placeholder" aria-hidden="true"></figure>
    <ul class="volunteer-team__list row-links" aria-label="{{ team.Value | Escape }} opportunities">
      {{ rows }}
    </ul>
  </div>
    {%- endif -%}
  {%- endfor -%}
  {%- enddefinedvalue -%}

  {%- comment -%} No team (or a team that's been removed): the last section {%- endcomment -%}
  {%- capture rows -%}
    {%- for opp in opportunities -%}
      {%- assign oppTeam = opp | Attribute:'ConnectedTeam','RawValue' | Downcase -%}
      {%- assign oppTeamKey = '|' | Append:oppTeam | Append:'|' -%}
      {%- unless oppTeam != '' and teamGuids contains oppTeamKey %}
      <li><a class="row-link" href="{{ detailUrl }}?OpportunityId={{ opp.Id }}" data-volunteer-modal="{{ opp.Id }}"><span class="row-link__label">{{ opp.PublicName | Default:opp.Name }}</span><span class="row-link__chev">{{ chevron }}</span></a></li>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign rows = rows | Trim -%}
  {%- if rows != '' -%}
    {%- assign flip = sectionCount | Modulo:2 -%}
    {%- assign sectionCount = sectionCount | Plus:1 -%}
    {%- capture tocLink %}<li><a class="content-toc__link" href="#serve-more">{{ otherHeading }}</a></li>{% endcapture -%}
    {%- assign tocLinks = tocLinks | Append:tocLink %}
  <div class="sermons-divider" id="serve-more"><h2>{{ otherHeading }}</h2></div>
  <div class="volunteer-team{% if flip == 1 %} volunteer-team--flip{% endif %}">
    <figure class="volunteer-team__photo content-photo content-photo--placeholder" aria-hidden="true"></figure>
    <ul class="volunteer-team__list row-links" aria-label="{{ otherHeading }}">
      {{ rows }}
    </ul>
  </div>
  {%- endif -%}
{%- endcapture -%}

<article class="content-page volunteer" itemscope itemtype="https://schema.org/Article">
  <meta itemprop="headline" content="Volunteer">
  <div class="content-toc-scope" itemprop="articleBody">

  {%- comment -%} Intro: edit the words here {%- endcomment %}
  <section class="content-lead content-lead--compact" aria-labelledby="volunteer-intro">
    <h2 id="volunteer-intro">Find your <span>team</span></h2>
    <p>Every weekend and all through the week, volunteers make Valley Real Life happen. Find a place that fits how God made you, and we'll help you get started.</p>
  </section>

  {%- if sectionCount > 1 %}
  <nav class="content-toc" aria-label="On this page" data-toc>
    <div class="content-toc__panel">
      <h2>On this page</h2>
      <ol>
        {{ tocLinks }}
      </ol>
    </div>
  </nav>
  {%- endif %}

  {%- if sectionCount > 0 %}
  {{ sectionsHtml }}
  {%- else %}
  <p class="content-standfirst">There are no openings listed right now. Check back soon.</p>
  {%- endif %}

  {%- if contactEmail != '' %}
  <section class="content-tile content-crosslink" aria-labelledby="volunteer-ask">
    <span class="content-tile__icon" aria-hidden="true"><svg width="22" height="22"><use href="#i-mail"/></svg></span>
    <div>
      <h2 id="volunteer-ask">Not sure where you fit?</h2>
      <p>Tell us a little about yourself and we'll help you find a team.</p>
    </div>
    <a class="btn btn--primary" href="mailto:{{ contactEmail }}?subject=Volunteering">Email us</a>
  </section>
  {%- else %}
  <div class="content-placeholder">
    <p class="content-placeholder__label">Still to come</p>
    <p>Not sure where you fit? Who to contact when no role fits (set contactEmail in VolunteerListing.lava).</p>
  </div>
  {%- endif %}

  </div>
</article>
