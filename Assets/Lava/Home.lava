              </button>
              <div class="share__menu" id="share-night-of-worship" data-open="false">
                <a class="share__item" href="https://www.facebook.com/sharer/sharer.php?u=" target="_blank" rel="noopener"><svg width="16" height="16" aria-hidden="true"><use href="#i-facebook"/></svg> Facebook</a>
                <a class="share__item" href="mailto:?subject=Night of Worship"><svg width="16" height="16" aria-hidden="true"><use href="#i-mail"/></svg> Email</a>
                <a class="share__item" href="sms:?&amp;body=Night of Worship"><svg width="16" height="16" aria-hidden="true"><use href="#i-message"/></svg> Text message</a>
                <div class="share__divider"></div>
                <button class="share__item" type="button" data-copy="https://vrl.church/events/night-of-worship"><svg width="16" height="16" aria-hidden="true"><use href="#i-copy"/></svg> <span>Copy link</span></button>
              </div>
            </div>
          </div>
        </li>
      </ul>

      <button class="events__nav events__nav--next" type="button" data-rail-next>
        <span class="u-visually-hidden">Scroll events right</span>
        <svg width="22" height="22" aria-hidden="true"><use href="#i-chevron-right"/></svg>
      </button>
    </div>

    <p class="events__all"><a class="btn btn--outline" href="/events">View all events</a></p>
  </div>
</section>

<!-- Footer runway: position: sticky can't hold a section past the end of
     its parent (this block's wrapper), so the runway extends that wrapper by
     the footer's height + a dwell and the footer slides back up over Events.
     Empty and hidden without JS. KEEP THIS THE LAST ELEMENT OF THIS FILE. -->
<div class="footer-runway" aria-hidden="true"></div>
