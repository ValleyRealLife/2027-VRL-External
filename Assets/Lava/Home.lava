{% comment %}
    HOMEPAGE CONTENT — for an HTML block in the homepage's Main zone.

    Block content:   {% include '~~/Assets/Lava/Home.lava' %}
    Cache duration:  0 while iterating

    The v1.5 concept's homepage sections, hardcoded for now. Most of the
    animation and the cover-section choreography are one-offs for this page;
    the content will move into dynamic Lava / blocks section by section.
    Generated by tools/port-concept.py; the `ROCK:` comments mark what each
    section needs from Rock.

    Hooks the scripts rely on (theme.js + home.js, loaded by Homepage.aspx):
      #stage           header turns transparent while it is under the bar
      [data-cover]     pinned "cover" sections (theme.js sets --stick-top)
      .footer-runway   MUST stay the last element here: sticky sections only
                       pin within their parent (this block's wrapper), so the
                       runway has to share it for the footer to slide over
                       Events (theme.js sets --footer-h)
{% endcomment %}
<!-- ============================================================
     STAGE: HERO → NEXT STEPS
     One scroll. The cards start fanned under the headline and
     shuffle up into the Next Steps row.
     ============================================================ -->
<section class="stage" id="stage" aria-labelledby="hero-title">
  <div class="stage__vp">

    <div class="container hero">
      <h1 id="hero-title"><span>Reaching the world</span><span class="u-visually-hidden"> — </span><span>One at a time</span></h1>
      <p class="hero__times">
        <strong>Service times</strong>
        <span>Thursdays at 6:30pm</span>
        <span>Sundays at 8:00, 9:30, 11:00am &amp; 12:30pm</span>
      </p>
      <p class="hero__cta"><a class="btn btn--primary btn--lg" href="/discover-vrl">Discover VRL</a></p>
    </div>

    <div class="container steps-head">
      <div class="section-head">
        <h2>Next steps</h2>
        <p>What's your next right step?</p>
      </div>
    </div>

    <!-- ===== COMPONENT: deck of step cards ===== -->
    <div class="deck" id="deck">
      <a class="step-card" href="/discover-vrl">
        <img src="https://picsum.photos/seed/vrl-step-discover/600/804" alt="" />
        <div class="step-card__scrim" aria-hidden="true"></div>
        <div class="step-card__body">
          <h3>Discover VRL</h3>
          <span class="btn btn--outline btn--sm">Learn more</span>
        </div>
      </a>
      <a class="step-card" href="/baptism">
        <img src="https://picsum.photos/seed/vrl-step-baptism/600/800" alt="" />
        <div class="step-card__scrim" aria-hidden="true"></div>
        <div class="step-card__body">
          <h3>Baptism</h3>
          <span class="btn btn--outline btn--sm">Learn more</span>
        </div>
      </a>
      <a class="step-card" href="/life-groups">
        <img src="https://picsum.photos/seed/vrl-step-groups/600/801" alt="" />
        <div class="step-card__scrim" aria-hidden="true"></div>
        <div class="step-card__body">
          <h3>Life groups</h3>
          <span class="btn btn--outline btn--sm">Learn more</span>
        </div>
      </a>
      <a class="step-card" href="/prayer">
        <img src="https://picsum.photos/seed/vrl-step-prayer/600/802" alt="" />
        <div class="step-card__scrim" aria-hidden="true"></div>
        <div class="step-card__body">
          <h3>Prayer</h3>
          <span class="btn btn--outline btn--sm">Learn more</span>
        </div>
      </a>
      <a class="step-card" href="/serve">
        <img src="https://picsum.photos/seed/vrl-step-serve/600/803" alt="" />
        <div class="step-card__scrim" aria-hidden="true"></div>
        <div class="step-card__body">
          <h3>Serve</h3>
          <span class="btn btn--outline btn--sm">Learn more</span>
        </div>
      </a>
    </div>

  </div>
</section>
<div class="stage__handoff" aria-hidden="true"></div>

<!-- ============================================================
     NEXT GEN: Kids + Students
     Same short content at every width: kicker, title, one line,
     button. Desktop: one band, Kids and Students side by side.
     Phones: two sections, Students rides up over Kids.
     ============================================================ -->
<div class="nextgen" data-cover>

<!-- ============================================================
     SECTION: VRL KIDS
     ============================================================ -->
<section class="kids" data-cover aria-labelledby="kids-title">
  <div class="kids__texture" aria-hidden="true"></div>
  <div class="container kids__inner">

    <div class="kids__copy-col">
      <p class="kids__kicker">Birth through 5th grade</p>
      <h2 id="kids-title" class="kids__title"><img src="{{ '~~/Assets/Images/VRLKids.webp' | ResolveRockUrl }}" width="1389" height="252" alt="VRL Kids" /></h2>
      <p class="kids__copy">
        Safe, simple check-in and a team that can't wait to meet your family.
      </p>
      <p class="kids__actions"><a class="btn btn--solid" href="/kids">Learn more</a></p>
    </div>

    <div class="kids__cluster">
      <!-- ROCK: both files are pre-cut circles on transparent ground.
           KidPopout's circle sits bottom-right in its file; the subject
           rises out of the top of it, past the dashed wheel. -->
      <figure class="kid-photo kid-photo--small" data-float>
        <svg class="kid-photo__wheel" data-wheel aria-hidden="true" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" pathLength="100" /></svg>
        <div class="kid-photo__disc"><img src="{{ '~~/Assets/Images/KidCircle.webp' | ResolveRockUrl }}" width="804" height="819" loading="lazy" alt="A mom and her toddler on the lawn at VRL" /></div>
      </figure>
      <figure class="kid-photo kid-photo--pop" data-float>
        <svg class="kid-photo__wheel" data-wheel aria-hidden="true" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" pathLength="100" /></svg>
        <div class="kid-photo__disc"><img src="{{ '~~/Assets/Images/KidPopout.webp' | ResolveRockUrl }}" width="1221" height="1438" loading="lazy" alt="A smiling boy on the VRL playground" /></div>
      </figure>
    </div>

  </div>
</section>

<!-- ============================================================
     SECTION: VRL STUDENTS  (rides up over Kids)
     ============================================================ -->
<section class="students" data-cover aria-labelledby="students-title">
  <div class="students__grain" aria-hidden="true"></div>
  <div class="container students__inner">

    <div class="students__copy">
      <p class="students__kicker">Middle school &amp; high school</p>
      <h2 id="students-title">VRL Students</h2>
      <p class="students__body">
        A place to belong, grow in Jesus and find out church is anything but boring.
      </p>
      <p class="students__actions"><a class="btn btn--primary" href="/students">Learn more</a></p>
    </div>

    <!-- Four pre-framed photos on transparent ground
         (Assets/Images/StudentFrame1-4.webp). -->
    <div class="scraps">
      <figure class="scrap scrap--1">
        <img src="{{ '~~/Assets/Images/StudentFrame1.webp' | ResolveRockUrl }}" width="813" height="982" loading="lazy" alt="A student overcome in worship" />
      </figure>
      <figure class="scrap scrap--2">
        <img src="{{ '~~/Assets/Images/StudentFrame2.webp' | ResolveRockUrl }}" width="778" height="936" loading="lazy" alt="A student leading worship on stage" />
      </figure>
      <figure class="scrap scrap--3">
        <img src="{{ '~~/Assets/Images/StudentFrame3.webp' | ResolveRockUrl }}" width="527" height="638" loading="lazy" alt="A student clapping during worship" />
      </figure>
      <figure class="scrap scrap--4">
        <img src="{{ '~~/Assets/Images/StudentFrame4.webp' | ResolveRockUrl }}" width="641" height="778" loading="lazy" alt="A student leader laughing, with 1 Timothy 4:12 written across the photo" />
      </figure>
    </div>

  </div>
</section>

</div><!-- /.nextgen -->

<!-- ============================================================
     SECTION: MESSAGES
     ============================================================ -->
<section class="messages" data-cover id="messages" data-playing="false" aria-labelledby="messages-title">
  <div class="messages__bg" aria-hidden="true">
    <img src="https://picsum.photos/seed/vrl-message-bg/1920/1080" loading="lazy" alt="" />
  </div>

  <div class="container messages__inner">
    <h2 class="messages__label" id="messages-title">Latest message</h2>

    <div class="messages__feature">
      <div class="messages__art">
        <!-- ROCK: series artwork from the content channel item -->
        <div class="ph-green">Beyond Sunday</div>
      </div>
      <p class="messages__desc">
        In week one of Beyond Sunday we look at what it actually means to put Jesus over everything —
        and why He is enough for everyone.
      </p>
      <button class="btn btn--primary btn--lg" type="button" data-watch>
        <svg width="16" height="16" aria-hidden="true"><use href="#i-play"/></svg>
        Watch now
      </button>
      <p class="messages__more"><a href="/messages">View previous messages <svg width="16" height="16" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></p>
    </div>

    <!-- ===== COMPONENT: recent series rail ===== -->
    <div class="series">
      <div class="series__head">
        <h3>Recent series</h3>
        <a href="/series">View all</a>
      </div>
      <div class="series__rail">
        <a class="series__item" href="/series/beyond-sunday"><div class="ph-green">Beyond Sunday</div></a>
        <a class="series__item" href="/series/questions"><div class="ph-green">Questions Jesus Asked</div></a>
        <a class="series__item" href="/series/no-other-gods"><div class="ph-green">No Other Gods</div></a>
        <a class="series__item" href="/series/formed"><div class="ph-green">Formed</div></a>
        <a class="series__item" href="/series/q-and-a"><div class="ph-green">Q + A</div></a>
        <a class="series__item" href="/series/from-the-dust"><div class="ph-green">From the Dust</div></a>
      </div>
    </div>
  </div>

  <!-- Player takes the frame once "Watch now" is pressed -->
  <div class="messages__player" aria-hidden="true">
    <div class="player">
      <div class="player__stage">
        <!-- ROCK: Rock media player / embed goes here -->
        <div class="ph-green">Message player</div>
      </div>
      <button class="player__close" type="button" data-watch-close>
        <span class="u-visually-hidden">Close player</span>
        <svg width="20" height="20" aria-hidden="true"><use href="#i-x"/></svg>
      </button>
      <div class="player__bar">
        <svg width="20" height="20" aria-hidden="true"><use href="#i-play"/></svg>
        <span class="player__progress" aria-hidden="true"><span></span></span>
        <span style="font-size:.75rem;font-weight:600">5:12 / 41:08</span>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     SECTION: UPCOMING EVENTS
     ============================================================ -->
<section class="events" data-cover aria-labelledby="events-title">
  <div class="container">
    <div class="section-head">
      <h2 id="events-title">What's happening</h2>
      <p>Find your place to connect</p>
    </div>

    <div class="events__rail-wrap">
      <button class="events__nav events__nav--prev" type="button" data-rail-prev>
        <span class="u-visually-hidden">Scroll events left</span>
        <svg width="22" height="22" aria-hidden="true"><use href="#i-chevron-left"/></svg>
      </button>

      <ul class="events__rail" id="events-rail" tabindex="0" aria-label="What's happening — upcoming events, scrollable">
        <li class="event-card">
          <div class="event-card__thumb">
            <img src="https://picsum.photos/seed/vrl-event-family-feast/640/360" loading="lazy" alt="Thursdays, starting June 25 event artwork" />
            <p class="event-card__date"><span class="m">Aug</span><span class="d">8</span></p>
          </div>
          <div class="event-card__body">
            <h3>Family Feast</h3>
            <p class="event-card__desc">Free dinner before the 6:30pm service. Bring lawn chairs, blankets, whatever you want.</p>
            <ul class="event-card__meta">
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-clock"/></svg> Thu, Aug 8 · 5:30pm</li>
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-map-pin"/></svg> Barker Campus</li>
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-users"/></svg> All ages</li>
            </ul>
          </div>
          <div class="event-card__actions">
            <a class="btn btn--primary btn--sm" href="/events/family-feast">Learn more</a>
            <div class="share">
              <button class="share__btn" type="button" aria-expanded="false" aria-controls="share-family-feast" data-share-toggle>
                <span class="u-visually-hidden">Share Family Feast</span>
                <svg width="20" height="20" aria-hidden="true"><use href="#i-share"/></svg>
              </button>
              <div class="share__menu" id="share-family-feast" data-open="false">
                <a class="share__item" href="https://www.facebook.com/sharer/sharer.php?u=" target="_blank" rel="noopener"><svg width="16" height="16" aria-hidden="true"><use href="#i-facebook"/></svg> Facebook</a>
                <a class="share__item" href="mailto:?subject=Family Feast"><svg width="16" height="16" aria-hidden="true"><use href="#i-mail"/></svg> Email</a>
                <a class="share__item" href="sms:?&amp;body=Family Feast"><svg width="16" height="16" aria-hidden="true"><use href="#i-message"/></svg> Text message</a>
                <div class="share__divider"></div>
                <button class="share__item" type="button" data-copy="https://vrl.church/events/family-feast"><svg width="16" height="16" aria-hidden="true"><use href="#i-copy"/></svg> <span>Copy link</span></button>
              </div>
            </div>
          </div>
        </li>
        <li class="event-card">
          <div class="event-card__thumb">
            <img src="https://picsum.photos/seed/vrl-event-mens-breakfast/640/360" loading="lazy" alt="Men's Breakfast event artwork" />
            <p class="event-card__date"><span class="m">May</span><span class="d">9</span></p>
          </div>
          <div class="event-card__body">
            <h3>Men's Breakfast</h3>
            <p class="event-card__desc">Join the guys of VRL at our monthly gathering — food, and an honest conversation.</p>
            <ul class="event-card__meta">
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-clock"/></svg> Fri, May 9 · 8:00am</li>
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-map-pin"/></svg> Barker Campus</li>
              <li><svg width="14" height="14" aria-hidden="true"><use href="#i-users"/></svg> Men</li>
