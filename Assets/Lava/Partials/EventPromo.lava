{% comment %}
    EVENT PROMO — one event as a card (.content-promo, Styles/_content.scss):
    its photo (a logo or title graphic, never cropped) over a frosted bar (a
    blurred copy of the photo behind it) with its next date and a button, the
    whole card linking to /events/{id}. Used for Rooted on Life Groups,
    MSM/HSM on Students and First Step Lunch on Discover VRL.

    Needs RockEntity on the calling block. Set, then include:

        {% assign promoOccurrenceId = 639 %}
        {% assign promoButtonText = 'Sign up for Rooted' %}   (optional)
        {% include '~~/Assets/Lava/Partials/EventPromo.lava' %}

      promoOccurrenceId  the event occurrence id (as in /events/{id})
      promoEventItemId   OR the calendar event's id (Rock's Event Detail
                         page); the card then uses whichever of its
                         occurrences is next. Wins over promoOccurrenceId,
                         and is cleared after each include.
      promoButtonText    the button (default: "Sign up for <event name>")

    Renders NOTHING unless the event is scheduled: active, approved, and with
    a next date no more than 30 minutes past (as the events list). To hide a
    section with it, capture the include and test the result:

        {%- capture promoHtml %}{% include '…/EventPromo.lava' %}{% endcapture -%}
        {%- assign promoHtml = promoHtml | Trim -%}
        {%- if promoHtml != '' %} … {{ promoHtml }} … {% endif -%}
{% endcomment %}
{%- assign promoOccurrenceId = promoOccurrenceId | AsInteger | Default:0 -%}
{%- assign promoButtonText = promoButtonText | Default:'' | Trim -%}
{%- assign promoEventItemId = promoEventItemId | AsInteger | Default:0 -%}
{%- if promoEventItemId > 0 -%}
  {%- comment -%} The event's soonest occurrence still within 30 minutes of starting {%- endcomment -%}
  {%- assign promoOccurrenceId = 0 -%}
  {%- assign promoBest = '' -%}
  {%- eventitemoccurrence where:'EventItemId == {{ promoEventItemId }}' securityenabled:'false' -%}
    {%- for promoOcc in eventitemoccurrenceItems -%}
      {%- assign promoOccNext = promoOcc.NextStartDateTime -%}
      {%- if promoOccNext -%}
        {%- assign promoOccAway = 'Now' | DateDiff:promoOccNext,'m' -%}
        {%- if promoOccAway >= -30 -%}
          {%- if promoBest == '' -%}
            {%- assign promoBest = promoOccNext -%}{%- assign promoOccurrenceId = promoOcc.Id -%}
          {%- else -%}
            {%- assign promoOccVsBest = promoBest | DateDiff:promoOccNext,'m' -%}
            {%- if promoOccVsBest < 0 -%}{%- assign promoBest = promoOccNext -%}{%- assign promoOccurrenceId = promoOcc.Id -%}{%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endeventitemoccurrence -%}
  {%- assign promoEventItemId = 0 -%}
{%- endif -%}
{%- if promoOccurrenceId > 0 -%}
{%- eventitemoccurrence id:'{{ promoOccurrenceId }}' securityenabled:'false' -%}
  {%- assign promoEvent = eventitemoccurrence.EventItem -%}
  {%- if eventitemoccurrence and promoEvent.IsActive and promoEvent.IsApproved and eventitemoccurrence.NextStartDateTime -%}
    {%- assign promoMinutesAway = 'Now' | DateDiff:eventitemoccurrence.NextStartDateTime,'m' -%}
    {%- if promoMinutesAway >= -30 -%}
    {%- if promoButtonText == '' %}{% assign promoButtonText = 'Sign up for ' | Append:promoEvent.Name %}{% endif -%}
  <div class="content-promo" data-card{% if promoEvent.Photo.Guid %} style="--promo-bg: url('/GetImage.ashx?guid={{ promoEvent.Photo.Guid }}&amp;w=400')"{% endif %}>
    {%- if promoEvent.Photo.Guid %}
    <img class="content-promo__image" src="/GetImage.ashx?guid={{ promoEvent.Photo.Guid }}&amp;w=1400" alt="{{ promoEvent.Name | Escape }}" loading="lazy">
    {%- else %}
    <p class="content-promo__title">{{ promoEvent.Name }}</p>
    {%- endif %}
    <div class="content-promo__bar">
      <dl class="content-promo__when"><dt>Next</dt><dd>{{ eventitemoccurrence.NextStartDateTime | Date:'dddd, MMMM d' }}</dd></dl>
      <a class="btn btn--primary" href="/events/{{ promoOccurrenceId }}" data-card-link>{{ promoButtonText }}</a>
    </div>
  </div>
    {%- endif -%}
  {%- endif -%}
{%- endeventitemoccurrence -%}
{%- endif -%}
